# ==============================================================================
# Swiggy Campus Circles - Environment Variables Configuration
# ==============================================================================

# Google Gemini API Key (Required for CircleMatch AI group meal explainers and smart suggestions)
GEMINI_API_KEY=your_gemini_api_key_here

# Campus Configuration (Defaults to 'PW Institute of Innovation Noida')
NEXT_PUBLIC_CAMPUS_NAME="PW Institute of Innovation Noida"

# Application URL (Use localhost for local dev or production URL on Vercel)
NEXT_PUBLIC_APP_URL="https://swiggy-hackathon.vercel.app"

# Demo Presets (set to true to enable pre-seeded student personas and demo circles)
NEXT_PUBLIC_ENABLE_DEMO_PRESETS="true"

# Supabase Credentials (Optional for local/demo mode; required for multi-device cloud realtime sync)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
