# Swiggy Campus Circles - Environment Variables
# Copy to .env.local for local development

# Google Gemini API Key (Server-side only, for CircleMatch AI natural language meal plan explanations)
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Credentials (Optional for local demo mode, required for cloud realtime sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Swiggy Builders Club MCP / Partner Credentials (Optional for live menus)
SWIGGY_CLIENT_ID=your-swiggy-client-id
SWIGGY_CLIENT_SECRET=your-swiggy-client-secret
SWIGGY_REDIRECT_URI=http://localhost:3000/api/auth/swiggy/callback
SWIGGY_AUTH_BASE_URL=https://mcp.swiggy.com/auth
SWIGGY_MCP_SERVER_URL=https://mcp.swiggy.com/food

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CAMPUS_NAME="BITS Pilani - Hyderabad Campus"
NEXT_PUBLIC_ENABLE_DEMO_PRESETS=true
