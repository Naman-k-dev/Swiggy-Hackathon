# ==============================================================================
# Swiggy Campus Circles - Environment Variables Configuration
# Production Domain: https://swiggyhackathon.vercel.app/
# Campus: PW Institute of Innovation Noida
# ==============================================================================

# Google Gemini API Key (Server-side only — NEVER use NEXT_PUBLIC prefix)
# Supports Google AI Studio authorization keys and standard API keys.
# Used for: CircleMatch AI meal plan explainers, CircleVote decisions, and Order Rescue summaries.
# Falls back deterministically if unconfigured or experiencing endpoint demand spikes.
GEMINI_API_KEY=""

# Campus Configuration (Defaults to 'PW Institute of Innovation Noida')
NEXT_PUBLIC_CAMPUS_NAME="PW Institute of Innovation Noida"

# Application URL (Production: https://swiggyhackathon.vercel.app | Dev: http://localhost:3000)
NEXT_PUBLIC_APP_URL="https://swiggyhackathon.vercel.app"

# Demo Presets (set to true to enable pre-seeded student personas and demo circles)
NEXT_PUBLIC_ENABLE_DEMO_PRESETS="true"

# Supabase Cloud Database Credentials (Optional for local demo mode; required for multi-student cloud sync)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Swiggy Builders Club MCP / Partner Credentials
# Keep disabled (empty) until official Swiggy partner OAuth client credentials are provided.
# When empty, the platform safely operates using the verified campus restaurant catalog.
SWIGGY_CLIENT_ID=""
SWIGGY_CLIENT_SECRET=""
SWIGGY_REDIRECT_URI="https://swiggyhackathon.vercel.app/api/auth/swiggy/callback"
SWIGGY_AUTH_BASE_URL="https://mcp.swiggy.com/auth"
SWIGGY_MCP_SERVER_URL="https://mcp.swiggy.com/food"
